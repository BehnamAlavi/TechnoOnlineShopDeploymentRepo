.env.example
# Environment Variables Template - Copy to .env and update values

# PostgreSQL Configuration
POSTGRES_PASSWORD=changeme_secure_password_here

# Registry Configuration
REGISTRY_OWNER=your_github_username

# Service Versions
TECHNO_API_VERSION=1.0.0
CONTROLPANEL_API_VERSION=1.0.0
FRONTEND_VERSION=1.0.0

# VPS Configuration
VPS_HOST=your-vps-ip

# Environment Settings
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Database Connection (internal)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=technoshopdb

# Redis Configuration (internal)
REDIS_HOST=redis
REDIS_PORT=6379

# API URLs
REACT_APP_API_URL=http://your-vps-ip:5001
REACT_APP_CONTROLPANEL_URL=http://your-vps-ip:5002
